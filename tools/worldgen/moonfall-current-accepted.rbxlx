					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Values in this module are working tuning defaults, not final balance.
return table.freeze({
	BasicAttackRange = 12,
	BasicAttackWindupSeconds = 0.2,
	BasicAttackInterval = 1.2,
	RangerBasicAttackRange = 55,
	RangerBasicAttackInterval = 1.4,
	MysticBasicAttackRange = 50,
	MysticBasicAttackInterval = 1.5,
	InputBufferSeconds = 0.2,
	AttackRequestMinIntervalSeconds = 0.03,
	TargetRequestMinIntervalSeconds = 0.03,
	SkillRequestMinIntervalSeconds = 0.03,
