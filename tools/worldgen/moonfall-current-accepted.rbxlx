	return table.freeze(values)
end

local function mob(values: any): CombatTypes.MobDefinition
	return table.freeze(values) :: CombatTypes.MobDefinition
end

-- Working vertical-slice tuning. Stable IDs are persistence/content contracts;
-- numeric balance remains intentionally easy to tune after owner runtime passes.
