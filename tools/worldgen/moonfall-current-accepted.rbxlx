		scaleXZ(80, 24, 962.5),
		scaleXZ(160, 34, 957.5),
		scaleXZ(227.5, 46, 957.5),
		scaleXZ(280, 60, 960),
		scaleXZ(320, 64, 995),
		scaleXZ(360, 68, 1035),
	},

	SpiderHollowRoute = {
		scaleXZ(0, 18, 970),
		scaleXZ(-85, 15, 962.5),
		scaleXZ(-165, 11, 960),
		scaleXZ(-235, 7, 965),
		scaleXZ(-280, 4, 970),
		scaleXZ(-320, 4, 1000),
		scaleXZ(-360, 4, 1030),
	},

	SpiderReturnRoute = {
		scaleXZ(-360, 4, 1030),
		scaleXZ(-315, 8, 1075),
		scaleXZ(-225, 14, 1115),
		scaleXZ(-130, 22, 1150),
		scaleXZ(0, 25, 1180),
	},

	AncientApproachRoute = {
		scaleXZ(0, 36, 1430),
		scaleXZ(0, 54, 1520),
		scaleXZ(0, 78, 1610),
		scaleXZ(0, 104, 1700),
		scaleXZ(0, 124, 1770),
	},

	-- X/Z authoring target only. Runtime/worldgen resolves the actual Terrain
	-- surface; Y must never be used as a placement height.
	RuinsOfSeleneEntranceQuery = scaleXZ(0, 0, 1950),
}

return table.freeze(WorldLayout)
]]></ProtectedString>
						<string name="ScriptGuid">{4EB0F744-F066-499A-9F48-66E7972EE046}</string>
