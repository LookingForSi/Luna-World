					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
local definitions = {
	quest_farm_message = { id="quest_farm_message", displayName="Вести с фермы", description="С фермы уже несколько дней приходят тревожные вести: ночью кто-то пугает скот, а люди боятся отходить далеко от домов. Отправляйтесь туда, найдите фермера и выясните, что происходит. Если сможете помочь — деревня это запомнит.", giverNpcId="npc_gatekeeper", turnInNpcId="npc_farmer", prerequisiteQuestIds={}, objectives={{id="talk_farmer",displayText="Поговорить с фермером",kind="TalkToNpc",npcId="npc_farmer",required=1}}, rewardXP=0,rewardLuna=25,autoTurnIn=true },
	quest_young_wolf_problem = { id="quest_young_wolf_problem", displayName="Волки у фермы", description="На нашу ферму в последнее время стали наведываться молодые волки: пугают людей и утаскивают овец прямо из загона. Мы пока держимся, но каждую ночь они подходят всё ближе. Прошу, защити ферму — отгони стаю и убей самых наглых хищников.", giverNpcId="npc_farmer", turnInNpcId="npc_farmer", prerequisiteQuestIds={"quest_farm_message"}, objectives={{id="kill_young_wolves",displayText="Убить молодых волков",kind="KillMob",mobId="mob_young_wolf",waypointPoiId="poi_young_wolf_staging",required=4}}, rewardXP=40,rewardLuna=30 },
	quest_stone_circle_pack = { id="quest_stone_circle_pack", displayName="Стая у каменного круга", description="Похоже, волки у фермы были лишь частью большой стаи. Следы ведут к старому каменному кругу, где звери собираются вокруг сильного вожака. Проредите стаю, одолейте вожака и разыщите дозорного Moonfall — он должен знать, что происходит дальше по дороге.", giverNpcId="npc_farmer", turnInNpcId="npc_moonfall_scout", prerequisiteQuestIds={"quest_young_wolf_problem"}, objectives={{id="kill_grey_wolves",displayText="Убить волков у каменного круга",kind="KillMob",mobId="mob_grey_wolf",waypointPoiId="poi_stone_circle",required=4},{id="kill_pack_leader",displayText="Победить вожака стаи",kind="KillMob",mobId="mob_wolf_pack_leader",waypointPoiId="poi_stone_circle",required=1}}, rewardXP=80,rewardLuna=45 },
	quest_goblin_threat = { id="quest_goblin_threat", displayName="Разведка лагеря гоблинов", description="Дозорный заметил движение гоблинов у старой дороги: патрули стали ходить чаще, а из лагеря слышны сигналы и крики. Подойдите к лагерю, разведайте укрепления и проредите внешнюю охрану. Не лезьте глубже без необходимости — сейчас важнее понять, насколько серьёзна угроза.", giverNpcId="npc_moonfall_scout", turnInNpcId="npc_moonfall_scout", prerequisiteQuestIds={"quest_stone_circle_pack"}, objectives={{id="reach_goblin_camp",displayText="Добраться до лагеря гоблинов",kind="ReachLocation",poiId="poi_goblin_camp",radius=90,required=1},{id="kill_goblin_scouts",displayText="Убить гоблинов-разведчиков",kind="KillMob",mobId="mob_goblin_scout",waypointPoiId="poi_goblin_camp",required=4},{id="kill_goblin_warrior",displayText="Убить гоблина-воина",kind="KillMob",mobId="mob_goblin_warrior",waypointPoiId="poi_goblin_camp",required=1}}, rewardXP=110,rewardLuna=55 },
	quest_spider_hollow = { id="quest_spider_hollow", displayName="Spider Hollow", description="За развилкой есть низина, которую местные давно обходят стороной. В последнее время пауки расползаются всё ближе к дороге, а среди них видели особенно крупную тварь. Осмотрите Spider Hollow, уничтожьте часть гнезда и разберитесь с большим пауком.", completionDescription="Spider Hollow снова безопаснее, но дальше начинаются северные земли. У границы Dark Woodland стоит другой дозорный. Найдите его у входа в лес — он следит за тем, что происходит дальше по дороге.", giverNpcId="npc_moonfall_scout", turnInNpcId="npc_moonfall_scout", prerequisiteQuestIds={"quest_goblin_threat"}, objectives={{id="reach_spider_hollow",displayText="Добраться до Spider Hollow",kind="ReachLocation",poiId="poi_spider_hollow",radius=90,required=1},{id="kill_spiders",displayText="Убить пауков",kind="KillMob",mobId="mob_spider",waypointPoiId="poi_spider_hollow",required=4},{id="kill_brood_spider",displayText="Победить большого паука",kind="KillMob",mobId="mob_brood_spider",waypointPoiId="poi_spider_hollow",required=1}}, rewardXP=130,rewardLuna=70 },
	quest_dark_woodland = { id="quest_dark_woodland", displayName="Через Dark Woodland", description="Дальше путь проходит через Dark Woodland — старый лес, где обычные звери давно не ведут себя как обычные. Лютые волки держат тропы под контролем и собираются вокруг альфы. Пробейтесь через лес, сократите стаю и устраните её вожака.", giverNpcId="npc_dark_woodland_scout", turnInNpcId="npc_dark_woodland_scout", prerequisiteQuestIds={"quest_spider_hollow"}, objectives={{id="reach_dark_woodland",displayText="Войти в Dark Woodland",kind="ReachLocation",poiId="entry_dark_woodland",radius=90,required=1},{id="kill_dire_wolves",displayText="Убить лютых волков",kind="KillMob",mobId="mob_dire_wolf",waypointPoiId="entry_dark_woodland",required=3},{id="kill_dire_alpha",displayText="Победить альфа-волка",kind="KillMob",mobId="mob_dire_wolf_alpha",waypointPoiId="entry_dark_woodland",required=1}}, rewardXP=180,rewardLuna=90 },
	quest_ancient_approach = { id="quest_ancient_approach", displayName="Ancient Approach", description="За тёмным лесом начинается Ancient Approach. Источник зла находится не здесь: оно пробуждается глубоко под землёй, за северной границей этих земель. Путь туда запечатан, и пока древний Moonbound Warden стоит на своём посту, врата в Ruins of Selene не откроются. Доберитесь до древнего пути и одолейте хранителя.", completionDescription="Страж повержен. Его смерть разрушила древнюю печать. На Ancient Approach появился лунный камень — проход в Ruins of Selene. Сообщите дозорному Dark Woodland, что северный путь открыт, а затем приготовьтесь спуститься к источнику зла.", giverNpcId="npc_dark_woodland_scout", turnInNpcId="npc_dark_woodland_scout", prerequisiteQuestIds={"quest_dark_woodland"}, objectives={{id="reach_ancient_approach",displayText="Добраться до Ancient Approach",kind="ReachLocation",poiId="poi_ancient_approach",radius=90,required=1},{id="kill_moonbound_warden",displayText="Победить Moonbound Warden",kind="KillMob",mobId="mob_moonbound_warden",waypointPoiId="poi_ancient_approach",required=1}}, rewardXP=250,rewardLuna=130 },
}
return table.freeze(definitions)
]]></ProtectedString>
