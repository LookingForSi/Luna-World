--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Controller={};local connection:RBXScriptConnection?=nil;local gui:ScreenGui?=nil
local action=ReplicatedStorage.Remotes:WaitForChild("DungeonAction")::RemoteEvent
local function label(parent:Instance,name:string,size:UDim2,pos:UDim2,text:string,textSize:number):TextLabel local l=Instance.new("TextLabel");l.Name=name;l.Size=size;l.Position=pos;l.BackgroundColor3=Color3.fromRGB(24,25,34);l.BackgroundTransparency=.12;l.TextColor3=Color3.fromRGB(235,232,220);l.Font=Enum.Font.Gotham;l.TextSize=textSize;l.TextWrapped=true;l.Text=text;l.Parent=parent;return l end
local function button(parent:Instance,name:string,pos:UDim2,text:string,callback:()->()):TextButton local b=Instance.new("TextButton");b.Name=name;b.Size=UDim2.fromOffset(150,38);b.Position=pos;b.BackgroundColor3=Color3.fromRGB(72,58,100);b.TextColor3=Color3.new(1,1,1);b.Font=Enum.Font.GothamBold;b.TextSize=14;b.Text=text;b.Parent=parent;b.Activated:Connect(callback);return b end
local function clearModal():()if gui then local old=gui:FindFirstChild("DungeonModal");if old then old:Destroy()end end end
local function modal(message:string,completion:boolean):()if not gui then return end;clearModal();local f=Instance.new("Frame");f.Name="DungeonModal";f.AnchorPoint=Vector2.new(.5,.5);f.Position=UDim2.fromScale(.5,.5);f.Size=UDim2.fromOffset(390,190);f.BackgroundColor3=Color3.fromRGB(19,20,29);f.Parent=gui;label(f,"Message",UDim2.new(1,-30,0,100),UDim2.fromOffset(15,15),message,18);button(f,"Accept",UDim2.new(.5,-160,1,-52),completion and "Вернуться в Moonfall"or"Войти",function()action:FireServer({action=completion and "Return"or"ConfirmEntry"});if not completion then clearModal()end end);button(f,"Cancel",UDim2.new(.5,10,1,-52),"Закрыть",clearModal)end
function Controller.start():()if gui then return end;gui=Instance.new("ScreenGui");gui.Name="DungeonUi";gui.ResetOnSpawn=false;gui.Parent=Players.LocalPlayer:WaitForChild("PlayerGui");local status=label(gui,"DungeonStatus",UDim2.fromOffset(330,70),UDim2.new(.5,-165,0,12),"",15);status.Visible=false
	connection=(ReplicatedStorage.Remotes.DungeonEvent::RemoteEvent).OnClientEvent:Connect(function(payload)if typeof(payload)~="table"then return end;if payload.state=="CONFIRM_ENTRY"then modal(payload.message or "Войти в Руины Селены?",false);return end;if payload.state=="COMPLETED"then local r=payload.reward or {};modal(string.format("РУИНЫ СЕЛЕНЫ ПРОЙДЕНЫ\n+%s XP  +%s Luna\nОсквернённая реликвия",tostring(r.xp or 0),tostring(r.luna or 0)),true)end;status.Visible=true;status.Text="Руины Селены\n"..tostring(payload.objective or payload.message or "Подготовка...");if payload.state=="RETURNING"or payload.state=="RETURN_RETRY"or payload.state=="FAILED"or payload.state=="WIPE"or payload.state=="BOSS_ENRAGED"then status.Text=tostring(payload.message or status.Text)end end)
end
function Controller.stop():()if connection then connection:Disconnect();connection=nil end;if gui then gui:Destroy();gui=nil end end
return Controller
