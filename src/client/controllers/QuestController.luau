local function buildMap(parent:ScreenGui):Frame local f=Instance.new("Frame");f.Name="WorldMap";f.Position=UDim2.fromScale(.16,.1);f.Size=UDim2.fromScale(.68,.78);f.BackgroundColor3=Color3.fromRGB(16,24,29);f.BackgroundTransparency=.12;f.Visible=false;f.Parent=parent;local title=text(f,"КАРТА МИРА [M]",20);title.Position=UDim2.fromOffset(15,8);title.Size=UDim2.new(1,-30,0,30)
	for _,p in WorldLayout.PointsOfInterest do local wanted={poi_main_gate=true,poi_moonfall_farm=true,poi_stone_circle=true,poi_moonfall_crossroads=true,poi_goblin_camp=true,poi_spider_hollow=true,entry_dark_woodland=true,poi_old_cemetery=true,poi_fallen_shrine=true,poi_ancient_approach=true};if wanted[p.id] then local x=(p.position.X-WorldLayout.WorldBounds.minX)/(WorldLayout.WorldBounds.maxX-WorldLayout.WorldBounds.minX);local z=(p.position.Z-WorldLayout.WorldBounds.minZ)/(WorldLayout.WorldBounds.maxZ-WorldLayout.WorldBounds.minZ);local l=text(f,"◆ "..p.id:gsub("poi_",""):gsub("_"," "),11);l.Position=UDim2.fromScale(x*.88+.05,z*.82+.1);l.Size=UDim2.fromOffset(145,22) end end;playerDot=text(f,"● YOU",12);playerDot.Size=UDim2.fromOffset(65,22);playerDot.TextColor3=Color3.fromRGB(100,210,255);questDot=text(f,"◆ QUEST",12);questDot.Size=UDim2.fromOffset(80,22);questDot.TextColor3=Color3.fromRGB(255,210,75);return f end
