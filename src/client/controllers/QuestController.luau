	local t=Instance.new("Frame");t.Name="QuestTracker";t.Position=UDim2.new(1,-305,0,220);t.Size=UDim2.fromOffset(285,220);t.BackgroundColor3=Color3.fromRGB(20,23,29);t.BackgroundTransparency=.22;t.Parent=g;tracker=t
	local d=Instance.new("Frame");d.Name="DialogueShell";d.Position=UDim2.fromScale(.3,.2);d.Size=UDim2.fromScale(.4,.55);d.BackgroundColor3=Color3.fromRGB(25,27,34);d.Visible=false;d.Parent=g;dialogue=d;map=buildMap(g)
	local w=text(g,"",15);w.Name="QuestWaypoint";w.AnchorPoint=Vector2.new(.5,.5);w.Size=UDim2.fromOffset(250,50);w.BackgroundTransparency=.2;w.BackgroundColor3=Color3.fromRGB(20,23,29);waypoint=w
	table.insert(connections,snapshotEvent.OnClientEvent:Connect(setSnapshot));table.insert(connections,dialogueEvent.OnClientEvent:Connect(openDialogue));table.insert(connections,UserInputService.InputBegan:Connect(function(input,processed) if not processed and input.KeyCode==Enum.KeyCode.M then QuestController.toggleMap() end end));table.insert(connections,RunService.RenderStepped:Connect(function() local target,name=trackedTarget();local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart");local camera=workspace.CurrentCamera;if not target or not root or not root:IsA("BasePart") or not camera or not waypoint then if waypoint then waypoint.Visible=false end;return end;if map and map.Visible and playerDot and questDot then local function project(pos:Vector3):UDim2 local x=(pos.X-WorldLayout.WorldBounds.minX)/(WorldLayout.WorldBounds.maxX-WorldLayout.WorldBounds.minX);local z=(pos.Z-WorldLayout.WorldBounds.minZ)/(WorldLayout.WorldBounds.maxZ-WorldLayout.WorldBounds.minZ);return UDim2.fromScale(x*.88+.05,z*.82+.1) end;playerDot.Position=project(root.Position);questDot.Position=project(target) end;local screen,onScreen=camera:WorldToViewportPoint(target+Vector3.new(0,8,0));waypoint.Visible=true;waypoint.Text=string.format("◆ %s · %d studs",name or "Цель",math.floor((root.Position-target).Magnitude));if onScreen and screen.Z>0 then waypoint.Position=UDim2.fromOffset(screen.X,screen.Y) else local center=camera.ViewportSize/2;local direction=Vector2.new(screen.X,screen.Y)-center;if direction.Magnitude<1 then direction=Vector2.new(0,-1) end;direction=direction.Unit;waypoint.Position=UDim2.fromOffset(center.X+direction.X*(center.X-130),center.Y+direction.Y*(center.Y-80));waypoint.Text="➤ "..waypoint.Text end end));request:FireServer()
end
