local snapshotEvent=remotes:WaitForChild("QuestSnapshot")::RemoteEvent;local dialogueEvent=remotes:WaitForChild("DialogueOpen")::RemoteEvent
local gui:ScreenGui?=nil;local tracker:Frame?=nil;local dialogue:Frame?=nil;local map:Frame?=nil;local waypoint:TextLabel?=nil;local playerDot:TextLabel?=nil;local questDot:TextLabel?=nil;local snapshot:any={quests={},markers={}};local connections={};local markerGuis={}
local function poi(id:string):Vector3? for _,p in WorldLayout.PointsOfInterest do if p.id==id then return p.position end end;return nil end
local function text(parent:Instance,value:string,size:number):TextLabel local l=Instance.new("TextLabel");l.BackgroundTransparency=1;l.Text=value;l.TextColor3=Color3.fromRGB(236,229,205);l.Font=Enum.Font.Gotham;l.TextSize=size;l.TextWrapped=true;l.TextXAlignment=Enum.TextXAlignment.Left;l.Parent=parent;return l end
