local function rebuildTracker() if not tracker then return end;clear(tracker);local layout=Instance.new("UIListLayout");layout.Padding=UDim.new(0,4);layout.Parent=tracker
	for i,q in snapshot.quests do if i>3 then break end;local lines={q.displayName};for _,o in q.objectives do table.insert(lines,string.format("• %s  %d/%d",o.displayText or o.id,o.progress,o.required)) end;if q.state=="ReadyToTurnIn" then table.insert(lines,"Вернуться к NPC") end;local l=text(tracker,table.concat(lines,"\n"),13);l.Size=UDim2.new(1,-10,0,28+#q.objectives*18) end end
local function npcTargetPosition(npcId:string):Vector3? local n=NpcDefinitions[npcId];if not n then return nil end;local base=poi(n.poiId);return if base then base+(n.positionOffset or Vector3.zero) else nil end
local function trackedTarget(): (Vector3?,string?) local quests=snapshot.quests or {};local q=quests[#quests];if not q then return nil,nil end;if q.state=="ReadyToTurnIn" then return npcTargetPosition(q.turnInNpcId),q.displayName end;for _,o in q.objectives do if o.progress<o.required then if o.npcId then return npcTargetPosition(o.npcId),q.displayName elseif o.poiId then return poi(o.poiId),q.displayName elseif o.waypointPoiId then return poi(o.waypointPoiId),q.displayName end end end;return nil,nil end
local function rebuildMarkers() for _,g in markerGuis do g:Destroy() end;table.clear(markerGuis);for _,m in snapshot.markers or {} do local n=NpcDefinitions[m.npcId];local model=if n then workspace:FindFirstChild(n.modelName,true) else nil;if model then local b=Instance.new("BillboardGui");b.Name="QuestMarker";b.AlwaysOnTop=true;b.MaxDistance=120;b.Size=UDim2.fromOffset(48,60);b.StudsOffset=Vector3.new(0,5,0);b.Adornee=model:FindFirstChild("Head") or model.PrimaryPart;b.Parent=Players.LocalPlayer.PlayerGui;local l=text(b,m.symbol,34);l.Size=UDim2.fromScale(1,1);l.TextColor3=Color3.fromRGB(246,205,75);l.TextXAlignment=Enum.TextXAlignment.Center;table.insert(markerGuis,b) end end end
