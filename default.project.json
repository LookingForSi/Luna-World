        "SkillRequest": { "$className": "RemoteEvent" },
        "SkillResult": { "$className": "RemoteEvent" },
        "RespawnRequest": { "$className": "RemoteEvent" },
        "CombatPresentation": { "$className": "RemoteEvent" },
        "InventoryActionRequest": { "$className": "RemoteEvent" },
        "InventorySnapshotRequest": { "$className": "RemoteEvent" },
        "InventorySnapshot": { "$className": "RemoteEvent" },
        "InventoryActionResult": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
