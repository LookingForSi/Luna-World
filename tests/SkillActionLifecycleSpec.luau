--!strict

local CooldownRules = require(game.ReplicatedStorage.Shared.combat.CooldownRules)
local ResourceRules = require(game.ReplicatedStorage.Shared.combat.ResourceRules)
local SkillActionLifecycle = require(game.ReplicatedStorage.Shared.combat.SkillActionLifecycle)
local SkillRules = require(game.ReplicatedStorage.Shared.combat.SkillRules)

return function(TestRunner)
	TestRunner.run("accepted skill has one action id and exactly one terminal result", function()
		local slot = SkillActionLifecycle.createSlot()
		local pending = SkillActionLifecycle.begin(slot, true, "action-1", "power_strike", "wolf-1")
		assert(pending ~= nil)
		local result = SkillActionLifecycle.finish(slot, pending, true, nil)
		assert(result ~= nil and result.actionId == "action-1" and result.applied)
		assert(SkillActionLifecycle.finish(slot, pending, true, nil) == nil, "a delayed duplicate must not emit")
	end)

	TestRunner.run("canceled accepted skill emits one safe failed result", function()
		local slot = SkillActionLifecycle.createSlot()
		local pending = SkillActionLifecycle.begin(slot, true, "action-2", "power_strike", "wolf-1")
		assert(pending ~= nil)
		local result = SkillActionLifecycle.finish(slot, pending, false, "Canceled")
		assert(result ~= nil and not result.applied and result.reason == "Canceled")
		assert(SkillActionLifecycle.finish(slot, pending, false, "Canceled") == nil)
	end)

	TestRunner.run("rejected payload and concurrent attempt do not replace active action", function()
		local slot = SkillActionLifecycle.createSlot()
		local maliciousDecision = SkillRules.validateRequest(2, "power_strike", true, "knight", "knight", false)
		assert(SkillActionLifecycle.begin(slot, maliciousDecision.accepted, "malicious", "power_strike", "wolf-1") == nil)
		assert(slot.pending == nil, "rejected extra payload must not mutate the slot")
		local first = SkillActionLifecycle.begin(slot, true, "first", "power_strike", "wolf-1")
		assert(first ~= nil)
		assert(SkillActionLifecycle.begin(slot, true, "second", "power_strike", "wolf-1") == nil)
		assert(slot.pending == first)
	end)

	TestRunner.run("cancel does not refund accepted resource or cooldown", function()
		local resource = ResourceRules.create("Stamina", 100)
		local spent = ResourceRules.spend(resource, "Stamina", 20)
		assert(spent ~= nil)
		local cooldowns = CooldownRules.start({}, "power_strike", 10, 4)
		local slot = SkillActionLifecycle.createSlot()
		local pending = SkillActionLifecycle.begin(slot, true, "action-3", "power_strike", "wolf-1")
		assert(pending ~= nil)
		assert(SkillActionLifecycle.finish(slot, pending, false, "Canceled") ~= nil)
		assert(spent.current == 80)
		assert(not CooldownRules.isReady(cooldowns, "power_strike", 13.9))
		assert(SkillActionLifecycle.shouldPreserveCooldowns(false), "death and character replacement preserve cooldowns")
		assert(not SkillActionLifecycle.shouldPreserveCooldowns(true), "player leave may discard session cooldowns")
	end)
end
