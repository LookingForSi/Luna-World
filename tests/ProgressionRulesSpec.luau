--!strict

local ProgressionConfig = require(game.ReplicatedStorage.Shared.config.ProgressionConfig)
local ProgressionRules = require(game.ReplicatedStorage.Shared.progression.ProgressionRules)

return function(TestRunner)
	TestRunner.run("progression curve exposes the approved level cap and thresholds", function()
		assert(ProgressionConfig.LevelCap == 10)
		assert(ProgressionRules.requiredXP(1) == 100)
		assert(ProgressionRules.requiredXP(5) == 460)
		assert(ProgressionRules.requiredXP(9) == 1140)
		assert(ProgressionRules.requiredXP(10) == nil)
	end)

	TestRunner.run("xp awards level exactly at the authoritative boundary", function()
		local before = ProgressionRules.applyXP(1, 99, 0)
		assert(before.level == 1 and before.xp == 99)
		local exact = ProgressionRules.applyXP(1, 99, 1)
		assert(exact.level == 2 and exact.xp == 0 and exact.levelsGained == 1)
	end)

	TestRunner.run("one xp reward can cross several levels", function()
		local result = ProgressionRules.applyXP(1, 0, 500)
		assert(result.level == 4)
		assert(result.xp == 0)
		assert(result.levelsGained == 3)
	end)

	TestRunner.run("level ten discards overflow and remains capped", function()
		local result = ProgressionRules.applyXP(9, 1139, 5000)
		assert(result.level == 10 and result.xp == 0 and result.levelsGained == 1)
		local capped = ProgressionRules.applyXP(10, 0, 5000)
		assert(capped.level == 10 and capped.xp == 0 and capped.levelsGained == 0)
	end)

	TestRunner.run("invalid progression inputs are rejected", function()
		assert(not ProgressionRules.isValidState(0, 0))
		assert(not ProgressionRules.isValidState(1, -1))
		assert(not ProgressionRules.isValidState(1, 100))
		assert(not ProgressionRules.isValidState(10, 1))
		assert(not pcall(function() ProgressionRules.applyXP(1, 0, -1) end))
		assert(not pcall(function() ProgressionRules.applyXP(1, 0, math.huge) end))
	end)

	TestRunner.run("skills unlock at levels two four and six", function()
		assert(not ProgressionRules.isSkillUnlocked(2, 1))
		assert(ProgressionRules.isSkillUnlocked(2, 2))
		assert(not ProgressionRules.isSkillUnlocked(4, 3))
		assert(ProgressionRules.isSkillUnlocked(4, 4))
		assert(not ProgressionRules.isSkillUnlocked(6, 5))
		assert(ProgressionRules.isSkillUnlocked(6, 6))
		assert(ProgressionRules.isSkillUnlocked(1, 1))
	end)

	TestRunner.run("mob xp increases modestly for higher level targets", function()
		assert(ProgressionRules.mobExperienceMultiplier(1, 1) == 1)
		assert(ProgressionRules.mobExperienceMultiplier(1, 2) == 1.1)
		assert(ProgressionRules.mobExperienceMultiplier(1, 3) == 1.2)
		assert(ProgressionRules.calculateMobXP(35, 1, 3) == 42)
	end)

	TestRunner.run("mob xp falls sharply when the player outlevels the target", function()
		assert(ProgressionRules.calculateMobXP(15, 2, 1) == 11)
		assert(ProgressionRules.calculateMobXP(15, 3, 1) == 8)
		assert(ProgressionRules.calculateMobXP(15, 4, 1) == 4)
		assert(ProgressionRules.calculateMobXP(15, 5, 1) == 2)
		assert(ProgressionRules.calculateMobXP(15, 6, 1) == 0)
		assert(ProgressionRules.calculateMobXP(15, 10, 1) == 0)
	end)
end
