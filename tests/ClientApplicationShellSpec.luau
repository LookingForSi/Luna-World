--!strict
return function(TestRunner)
	local root = game:GetService("StarterPlayer").StarterPlayerScripts.Client.application
	local State = require(root.ApplicationState)
	local Gate = require(root.ArrivalReadyGate)
	local Runtime = require(root.FeatureRuntime)
	local Shell = require(root.ClientApplicationShell)
	TestRunner.it("requires both arrival signals", function()
		local calls = 0; local gate = Gate.new(function() calls += 1 end)
		gate:setCharacterReady(true); TestRunner.expectEqual(calls, 0); gate:setArrivalReady(true); gate:setArrivalReady(true); TestRunner.expectEqual(calls, 1)
	end)
	TestRunner.it("rolls back partial startup", function()
		local stopped = 0; local runtime = Runtime.new({{name="ok",start=function() end,stop=function() stopped += 1 end},{name="bad",start=function() error("boom") end,stop=function() end}})
		local ok = runtime:start(); TestRunner.expectEqual(ok, false); TestRunner.expectEqual(stopped, 1)
	end)
	TestRunner.it("transitions once into gameplay", function()
		local starts = 0; local lobby = Runtime.new({}); local gameplay = Runtime.new({{name="g",start=function() starts += 1 end,stop=function() end}})
		local shell = Shell.new(lobby, gameplay, function(_id) end); shell:startLobby(); shell:enterGameplay("hero"); shell:enterGameplay("hero")
		TestRunner.expectEqual(shell.state, State.Gameplay); TestRunner.expectEqual(starts, 1)
	end)
end
