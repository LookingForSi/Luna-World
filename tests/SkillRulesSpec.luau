--!strict

local SkillRules = require(game.ReplicatedStorage.Shared.combat.SkillRules)
local SkillDefinitions = require(game.ReplicatedStorage.Shared.definitions.SkillDefinitions)
local DamageRules = require(game.ReplicatedStorage.Shared.combat.DamageRules)

return function(TestRunner)
	TestRunner.run("skill intent accepts only one string identifier", function()
		assert(not SkillRules.validateRequest(0, nil, false, nil, "knight", false).accepted)
		assert(not SkillRules.validateRequest(1, true, false, nil, "knight", false).accepted)
		assert(not SkillRules.validateRequest(2, "power_strike", true, "knight", "knight", false).accepted)
		assert(not SkillRules.validateRequest(5, "power_strike", true, "knight", "knight", false).accepted, "client damage, target lists, time, and crit payloads must be rejected")
		assert(not SkillRules.validateRequest(1, "missing", false, nil, "knight", false).accepted)
		assert(SkillRules.validateRequest(1, "power_strike", true, "knight", "knight", false).accepted)
	end)

	TestRunner.run("target context cannot substitute friendly and hostile entities", function()
		assert(SkillRules.isTargetContextAllowed("Enemy", "Mob", false))
		assert(not SkillRules.isTargetContextAllowed("Enemy", "Player", false))
		assert(not SkillRules.isTargetContextAllowed("Friendly", "Mob", false))
		assert(SkillRules.isTargetContextAllowed("Friendly", "Player", false))
		assert(SkillRules.isTargetContextAllowed("Self", "Player", true))
		assert(not SkillRules.isTargetContextAllowed("Self", "Player", false))
	end)

	TestRunner.run("skill intent cannot cross archetypes or bypass basic attack input", function()
		assert(not SkillRules.validateRequest(1, "power_shot", true, "ranger", "knight", false).accepted)
		assert(not SkillRules.validateRequest(1, "knight_basic_attack", true, "knight", "knight", true).accepted)
	end)

	TestRunner.run("skill acceptance requires every authoritative prerequisite", function()
		assert(SkillRules.canAccept("Ready", true, true, true))
		assert(not SkillRules.canAccept("Windup", true, true, true), "simultaneous actions must be blocked")
		assert(not SkillRules.canAccept("Recovery", true, true, true))
		assert(not SkillRules.canAccept("Ready", false, true, true))
		assert(not SkillRules.canAccept("Ready", true, false, true))
		assert(not SkillRules.canAccept("Ready", true, true, false))
	end)

	TestRunner.run("enemy targets must remain selected alive in range and facing", function()
		assert(SkillRules.isEnemyTargetValid("wolf-1", "wolf-1", true, true, true, true))
		assert(not SkillRules.isEnemyTargetValid("wolf-1", "wolf-2", true, true, true, true))
		assert(not SkillRules.isEnemyTargetValid(nil, "wolf-1", true, true, true, true))
		assert(not SkillRules.isEnemyTargetValid("wolf-1", "wolf-1", false, true, true, true))
		assert(not SkillRules.isEnemyTargetValid("wolf-1", "wolf-1", true, false, true, true))
		assert(not SkillRules.isEnemyTargetValid("wolf-1", "wolf-1", true, true, false, true))
		assert(not SkillRules.isEnemyTargetValid("wolf-1", "wolf-1", true, true, true, false))
	end)

	TestRunner.run("friendly fallback is explicit and never inferred from client payload", function()
		assert(SkillRules.shouldSelfCastFriendly(false, true))
		assert(not SkillRules.shouldSelfCastFriendly(false, false))
		assert(not SkillRules.shouldSelfCastFriendly(true, true))
	end)

	TestRunner.run("power strike is one critical-capable physical result", function()
		local definition = SkillDefinitions.power_strike
		assert(definition.effect.kind == "DirectDamage")
		assert(definition.powerSource == "PhysicalAttack")
		assert(definition.canCrit)
		local result = DamageRules.resolve(25 * definition.effect.magnitude, definition.effect.kind, definition.canCrit, 1, 1.5, function()
			return 0
		end)
		assert(result.isCritical)
		assert(result.amount == 56.25)
	end)

	TestRunner.run("shield bash is one non-critical physical result plus bounded control", function()
		local definition = SkillDefinitions.shield_bash
		assert(definition.effect.kind == "ShieldBash")
		assert(definition.powerSource == "PhysicalAttack")
		assert(not definition.canCrit)
		local result = DamageRules.resolve(25 * definition.effect.magnitude, definition.effect.kind, definition.canCrit, 1, 1.5, function()
			error("non-critical shield bash must not request a critical roll")
		end)
		assert(not result.isCritical)
		assert(result.amount == 12.5)
	end)
end
